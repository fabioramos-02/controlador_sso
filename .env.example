# SSO do Controlador
# Homologação: https://hom.control.ms.gov.br | Produção: https://control.ms.gov.br
CONTROL_URL=https://hom.control.ms.gov.br

# Credenciais que a SETDIG entrega ao órgão, uma por ambiente.
CLIENT_ID=des.testeassinador
# Fica só no servidor. Nunca no front nem no repositório.
CLIENT_SECRET=

# Tem que ser IGUAL ao callback cadastrado para o client.
# A porta da PoC sai daqui (64178).
REDIRECT_URI=http://localhost:64178/Default
